{
  "name": "noot",
  "private": true,
  "version": "0.0.0",
  "description": "noot — peer-to-peer campus tutoring. Monorepo: iOS/Android/web app (Expo) + marketing site (Next.js).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "pnpm --filter @noot/mobile dev",
    "mobile-team": "pnpm --filter @noot/mobile dev:tunnel",
    "tunnel": "bash scripts/tunnel.sh",
    "web": "pnpm --filter @noot/web dev"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
