{
  "expo": {
    "name": "noot",
    "slug": "noot",
    "scheme": "noot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.watchmenventures.noot",
      "buildNumber": "9",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "noot needs access to your photos so you can set a profile picture and send images in chat.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock noot.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "noot can save images you receive in chat to your photo library.",
        "NSCameraUsageDescription": "noot does not take photos. A library noot uses can access the camera, so iOS requires this notice.",
        "NSMicrophoneUsageDescription": "noot does not record audio. A library noot uses can access the microphone, so iOS requires this notice."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.watchmenventures.noot",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F2EC"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F2EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161C16"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock noot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow noot to access your photos so you can set a profile picture and send images in chat.",
          "cameraPermission": "noot does not take photos. A library noot uses can access the camera, so iOS requires this notice.",
          "microphonePermission": "noot does not record audio. A library noot uses can access the microphone, so iOS requires this notice."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.watchmenventures.noot",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90b65fed-7d81-40a0-8b69-69fa8381ef55"
      }
    },
    "owner": "oreillyjadin"
  }
}
