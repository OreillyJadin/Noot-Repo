{
  "expo": {
    "name": "noot",
    "slug": "noot",
    "scheme": "noot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2EC",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#161C16"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.watchmenventures.noot",
      "buildNumber": "2",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "noot needs access to your photos so you can set a profile picture and send images in chat.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock noot.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.watchmenventures.noot",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F2EC"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock noot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow noot to access your photos so you can set a profile picture and send images in chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.watchmenventures.noot",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90b65fed-7d81-40a0-8b69-69fa8381ef55"
      }
    },
    "owner": "oreillyjadin"
  }
}
