{
  "expo": {
    "name": "noot",
    "slug": "noot",
    "scheme": "noot",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.noot.app"
    },
    "android": {
      "package": "com.noot.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock noot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow noot to access your photos so you can set a profile picture."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.noot.app",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90b65fed-7d81-40a0-8b69-69fa8381ef55"
      }
    },
    "owner": "oreillyjadin"
  }
}
