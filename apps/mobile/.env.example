# Public client config — safe to ship in the bundle (RLS enforces access).
# Copy to .env and fill in.
#
# LOCAL (supabase start): these are the fixed, well-known local values printed by
# `supabase start` — the anon key is the same on every machine, safe to paste:
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<the "anon key" from `supabase start` / `supabase status`>
#
# CLOUD: from your Supabase project → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
