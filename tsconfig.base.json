{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@noot/theme": ["./packages/theme/src/index.ts"],
      "@noot/ui": ["./packages/ui/src/index.ts"],
      "@noot/core": ["./packages/core/src/index.ts"],
      "@noot/core/*": ["./packages/core/src/*"]
    }
  }
}
