# Copy to .noot-secrets.local.env and fill in. That file is gitignored and must be chmod 600.
# Load with:  source scripts/dev-env.sh
#
# Where each one comes from:

# Supabase dashboard -> Account -> Access Tokens -> Generate new token.
# MUST be the classic 2-part form `sbp_` + 40 hex (44 chars total). The CLI rejects the
# newer 3-part `sbp_XX_<hex>` shape with LegacyInvalidAccessTokenError before it even
# makes a request. Used by: pnpm check:preview, supabase functions deploy.
SUPABASE_ACCESS_TOKEN=

# expo.dev -> Account settings -> Access tokens. Used by: eas build / eas submit.
EXPO_TOKEN=

# Stripe dashboard -> Developers -> API keys. sk_ is SECRET — never commit it anywhere.
# Swap test -> live only at go-live (see ASC_SUBMISSION_CHECKLIST.md).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# NOT stored on purpose: the production service_role key. SUPABASE_ACCESS_TOKEN can mint or
# read it on demand via the Management API, so keeping a second copy of the most dangerous
# key on disk buys nothing. The LOCAL service_role key is a published dev constant and is
# already inline in scripts/verify_*.mts.
